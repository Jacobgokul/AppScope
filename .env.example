# =============================================================================
# AppScope Environment Configuration
# =============================================================================
# Copy this file to .env and configure for your environment.
# NEVER commit .env to version control - it contains secrets!
#
# Generate a secure SECRET_KEY with:
#   openssl rand -hex 32
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Development (Docker Compose)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/appscope

# Production (update with actual credentials)
# DATABASE_URL=postgresql+asyncpg://appscope_user:STRONG_PASSWORD@db-host:5432/appscope
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=appscope

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# REQUIRED: Generate with `openssl rand -hex 32`
# WARNING: Application will NOT START without a secure secret key!
SECRET_KEY=your-super-secret-key-change-in-production

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=AppScope
DEBUG=false
API_V1_PREFIX=/api/v1

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# -----------------------------------------------------------------------------
# URLs
# -----------------------------------------------------------------------------
# Backend API URL (for frontend to connect)
API_URL=http://localhost:8000

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:5173

# CORS Origins (JSON array format)
# Development:
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
# Production:
# CORS_ORIGINS=["https://app.appscope.io"]

# -----------------------------------------------------------------------------
# AI / LLM Configuration (Optional - for AI analysis features)
# -----------------------------------------------------------------------------
# Anthropic Claude API
LLM_API_URL=https://api.anthropic.com/v1
LLM_API_KEY=your-anthropic-api-key

# OpenAI (alternative)
# OPENAI_API_KEY=your-openai-key

# -----------------------------------------------------------------------------
# Redis Configuration (Optional - for caching)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# -----------------------------------------------------------------------------
# Agent Configuration (for agent deployment)
# -----------------------------------------------------------------------------
# AppScope server URL that agents connect to
APPSCOPE_SERVER_URL=https://api.appscope.io

# -----------------------------------------------------------------------------
# Production-Specific Settings
# -----------------------------------------------------------------------------
# Uncomment and configure these for production deployment

# TLS/SSL
# SSL_CERT_FILE=/etc/ssl/certs/appscope.crt
# SSL_KEY_FILE=/etc/ssl/private/appscope.key

# Sentry (Error Tracking)
# SENTRY_DSN=https://xxx@sentry.io/xxx

# Email Configuration (for notifications)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_FROM=noreply@appscope.io
