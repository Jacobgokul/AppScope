# AppScope Agent Environment Variables
# Copy this file to .env and fill in your values
# Usage: docker-compose --env-file .env up

# ============================================================================
# REQUIRED: API Credentials
# ============================================================================

# Your AppScope API key (get from https://appscope.io/dashboard/projects)
APPSCOPE_API_KEY=ask_proj_xxxxxxxxxxxxxxxx

# AppScope server URL
APPSCOPE_SERVER_URL=https://api.appscope.io

# ============================================================================
# Database Credentials (Optional)
# ============================================================================

# PostgreSQL
DB_PASSWORD=your_postgres_password

# Redis
REDIS_PASSWORD=your_redis_password

# MongoDB
MONGO_PASSWORD=your_mongo_password

# MySQL
MYSQL_PASSWORD=your_mysql_password

# ============================================================================
# Agent Configuration
# ============================================================================

# Log level: debug, info, warn, error
APPSCOPE_LOG_LEVEL=info

# Collection interval in seconds
APPSCOPE_COLLECTION_INTERVAL=30

# Project name
APPSCOPE_PROJECT=my-application

# ============================================================================
# Build Arguments (Optional)
# ============================================================================

BUILD_TIME=
GIT_COMMIT=
