# =============================================================================
# Backend Docker Ignore
# =============================================================================
# Files and directories to exclude from Docker build context.
# This speeds up builds and prevents sensitive files from being included.
# =============================================================================

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
env/
venv/
ENV/
.venv/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Environment files (sensitive)
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Git
.git/
.gitignore

# Documentation
docs/
*.md
!README.md

# Docker
Dockerfile
docker-compose*.yml

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db

# Temporary files
tmp/
temp/
*.tmp
*.bak
