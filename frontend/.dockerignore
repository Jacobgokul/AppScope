# =============================================================================
# Frontend Docker Ignore
# =============================================================================
# Files and directories to exclude from Docker build context.
# =============================================================================

# Dependencies (will be installed fresh in container)
node_modules/

# Build output (will be rebuilt in container)
dist/
build/

# Development artifacts
.cache/
.parcel-cache/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Testing
coverage/
.nyc_output/

# Environment files
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Git
.git/
.gitignore

# Documentation
*.md
!README.md

# Docker
Dockerfile
docker-compose*.yml

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Storybook (if used)
.storybook/
storybook-static/

# ESLint cache
.eslintcache
